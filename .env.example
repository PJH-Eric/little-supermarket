# Render 會自動提供 PORT；本機可用 3030
PORT=3030
HOST=0.0.0.0

# 允許的 GitHub Pages 網址，可用逗號分隔多個 origin；正式環境請不要使用 *
GAME_ALLOWED_ORIGIN=https://YOUR_GITHUB_USER.github.io

# Render 前端靜態頁若同源服務時可省略；GitHub Pages 前端使用 Repository Variable 注入
GAME_SERVER_URL=http://localhost:3030
GAME_SERVER_WS_URL=ws://localhost:3030

# 房間與訊息清理
ROOM_IDLE_MS=1800000
INVITE_TTL_MS=86400000
